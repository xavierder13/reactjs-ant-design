# vueportal API address(es). Several may be listed, comma-separated, with
# fallback (src/utils/apiBaseUrl.js): a page opened over http tries the http
# addresses first, then the https ones; a page opened over https uses only
# the https ones. The first that answers is used; on a network failure the
# app moves to the next. All must be the same backend + database. E.g.:
# VITE_API_BASE_URL=http://192.168.1.29:8000/api,https://portal.addessahub.com/api
# VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://192.168.10.101:8080/api
# VITE_API_BASE_URL=http://10.145.31.209:8080/api
# VITE_API_BASE_URL=http://10.147.222.209:8080/api
# VITE_API_BASE_URL=/api